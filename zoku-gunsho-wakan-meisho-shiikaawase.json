  {
   "id": "zoku-gunsho-wakan-meisho-shiikaawase-0001",
   "pid": "nao-734092",
   "pages": [
    1
   ],
   "text": "和漢名所詩歌合九条内大臣基家詠給之問左左右錢塘湖住吉浦虎渓春日山彭霊湖三島江悟真寺葛木山遺愛寺遺愛寺泊瀬山梁園武蔵野",
   "poems": []
  },
  {
   "id": "zoku-gunsho-wakan-meisho-shiikaawase-0002",
   "pid": "nao-734092",
   "pages": [
    2
   ],
   "text": "巫山松浦鄭谷龍門龍門吉野宇治河鏡湖金谷金谷信太社函谷関清見関頴河大井川候山伊助山蘇州美豆御牧汾陽清瀧河南朱閣高円山陵園水無瀬河昆明池昆明池音羽河商山商山常磐山須磨浦洞庭湖須磨浦上陽宮上陽宮龍田山尋陽江蘆屋里盧山冨士山呉江伊勢海高砂蜀都",
   "poems": []
  },
  {
   "id": "zoku-gunsho-wakan-meisho-shiikaawase-0003",
   "pid": "nao-734092",
   "pages": [
    3
   ],
   "text": "華陽洞田籠浦難波江覆道里難波江溜陽酒陽若浦香炉峰彭沢猪名野厳陵瀬明石浦香山佐夜中山鳴海浦胡塞天香貝山驪山一番左銭塘湖十九日湖郡西晴江月曙枕楼南遠海雲長右住吉浦住吉のいかきのうちに燈す火やまとへる哥の闇路なるらん二番左煙波万里柳陰泊山水六年花主郷右すみの元に神のかたひくつなしあらは汐世のに船をして出とも",
   "poems": [
    "1",
    "2"
   ]
  },
  {
   "id": "zoku-gunsho-wakan-meisho-shiikaawase-0004",
   "pid": "nao-734092",
   "pages": [
    4
   ],
   "text": "三番左虎渓竹陰東院鶯千囀山脚南泉雪一朝右春日山かすか山心のたねをまき置し野辺とやみえん花のこと草四番左一嵐底独流独流独流松径水月前三度虎渓橋右なくそちに身は行かゝる春日山祈りし岑に月はくもるな五番左彭霊湖三洲蘆晴蛍知夜万里山湖蛍知夜万里山消波洗虚右三島江みしまえに芦かりすつる里人のかへさは松の音そすくなき六番左湖上秋望嵐送艇江南霜信雁伝書右右人なみにしつみ果たるみしまえの入江のみくりさけむせふらん",
   "poems": [
    "3",
    "4",
    "5",
    "6"
   ]
  },
  {
   "id": "zoku-gunsho-wakan-meisho-shiikaawase-0005",
   "pid": "nao-734092",
   "pages": [
    5
   ],
   "text": "七番左悟真寺謹し一渓陵遠樹一峰嶋渭水綱絲千里郷右葛木山かつらきやおくの岩やの荒ましに心すめとや月はすむらん八番左嶺上楼台高有勢庭前松樹乱無行右かつらきや嵐をゝへる山伏の苔のそてにも花そかゝれる九番左遺愛寺鐘響東西雙院桃嵐前後一渓松右泊瀬山吾宿やよはすみかたき初瀬山かすむ河瀬山かすむ河瀬に月そ残れる十番立秋橋苔白月宵路遠寺燈幽花夕峯あま小船初瀬の山に雁鳴て夕日さしこす峯の桟右",
   "poems": [
    "7",
    "8",
    "9",
    "10"
   ]
  },
  {
   "id": "zoku-gunsho-wakan-meisho-shiikaawase-0006",
   "pid": "nao-734092",
   "pages": [
    6
   ],
   "text": "十一番左梁園夕占一花雪浮盞暁入那山月作隣右武蔵野むさし野はあすもいかなる露ならん同しころもの秋の花深十二番左立十二日霜冷鶴洲松柏夜鴬吟梁舘竹歌春右落つもる露のきえすはむさし野の草葉の下や海となりまし十三番立巫山雨度倡楼秋夢脆花廻舞樹曉衣薫右松浦山あふきをもあ気てたとへよ松浦姫ひれふる袖の月にかせとか十四番左猿声台下数行涙鬢色山中一尺雲右瓜木たく烟そ降たふ松浦山もろこしへや冬こもるらん",
   "poems": [
    "11",
    "12",
    "13",
    "14"
   ]
  },
  {
   "id": "zoku-gunsho-wakan-meisho-shiikaawase-0007",
   "pid": "nao-734092",
   "pages": [
    7
   ],
   "text": "十五番左鄭谷高低泉咽苔巌水南北風寒柴ハ船右御室山み宝山よゝの鏡や五月雨の雲のこなたの月をみすらん十六番一烟柳成薪千峯樹霜禽授箭一渓仙立右右みむろ山したはふ葛の玉かつらかけてや雪のふるの神杉十七番左龍門東岸菊芳新白雪青山松怨昔秋風右吉野よし野山これもや花の数ならんみかきの原の秋の白きく十八番立鴬吟蕭寺千行柳鳳狎龍門百尺桐右さて咲春にならひのよし野山月にかくるな岑の白雲",
   "poems": [
    "15",
    "16",
    "17",
    "18"
   ]
  },
  {
   "id": "zoku-gunsho-wakan-meisho-shiikaawase-0008",
   "pid": "nao-734092",
   "pages": [
    8
   ],
   "text": "十九番左鏡湖涙の雁陣度湖朝蕭波漁燈伝鳴夜知舟右宇治川老ぬとて哀かくへき人そなき波にぬれたる宇治の橋姫二十番左右野花霜満鹿声僻河蓼鷺蔵魚鬘浮ふけぬるかうちの河瀬をさす棹のうゝかすさひそ月に残れる二十一番左金谷松梢加彩画図障霞影装紅錦繍桜右信太社つく〳〵といつもなけきの同しえになをやしのたの杜のうくひす二十二番左園裏風光花百樹河南古跡水三流ちえことのしつくは雪のたるひにてしのたのもりはみかさなくとも右",
   "poems": [
    "19",
    "20",
    "21",
    "22"
   ]
  },
  {
   "id": "zoku-gunsho-wakan-meisho-shiikaawase-0009",
   "pid": "nao-734092",
   "pages": [
    9
   ],
   "text": "二十三番左函谷関万里花多鶯作友二靖草暗馬噺閔右清見関きよみかたかすめる関のむかひより又煙たつふしの大嶋二十四番立二月十一日巴鶏高報暁松路旅店猶宿秋月山右関の戸は入海かけて清みかたかたかたかへこそはみめ秋の月二十五番左頴河許県故山雲作へ頴河旧旧室浪廻橋右大井川大井川かみはあかしの山さくらちれは入江の松のしらゆき二十六番立一台高崎町一台高崎辺陵潰三使空帰遂咲完右大井川はちあるみよの筏士は今やよもなの嶋つたふらん",
   "poems": [
    "23",
    "24",
    "25",
    "26"
   ]
  },
  {
   "id": "zoku-gunsho-wakan-meisho-shiikaawase-0010",
   "pid": "nao-734092",
   "pages": [
    10
   ],
   "text": "二十七番左縦山孤洞碧桃春夕樹一台秋楽暁嵐松右伊駒山ほとゝきすいこまの山は夏なからなに秋しのゝ里なれぬらん二十八番左月幽渓嶺寛裳曲雲断笙山鶴駕班右あはれとはみつゝそこゆるいこま山花のあたりにのこる月影二十九番左蘇州台下苔深雲色近江心松咽浪声開右美豆御牧五月雨に里にもみつの河近みほすりこもや庭の浮草三十番左右西亭日薄千竿竹東桂月高六代山里しるき民の煙をのこしつゝ水上はるゝみつの河きり",
   "poems": [
    "27",
    "28",
    "29",
    "30"
   ]
  },
  {
   "id": "zoku-gunsho-wakan-meisho-shiikaawase-0011",
   "pid": "nao-734092",
   "pages": [
    11
   ],
   "text": "三十一番左防陽河垣湾鷺度孤松緑江県舟来一葉紅右清瀧河きよたきや氷はてたる河風に猶石はしる雪のしら波三十二番左美豆腐地商客晩望通素月漢皇昔宴向秋風右山もとの清滝川のそは伝ひ紅葉になりぬ桴をす郭三十三番左南朱閣一幽磬寺荒鐘似昔吹簫跡僻月残秋右高円山たかまとの山したあらしさゆる夜の野かみの薄露置ぬへし三十四番左燈照枕席夜尼院鶯伴笙歌春妓楼右雪もまた名におふみやと古郷の籬はけさやたまとの月",
   "poems": [
    "31",
    "32",
    "33",
    "34"
   ]
  },
  {
   "id": "zoku-gunsho-wakan-meisho-shiikaawase-0012",
   "pid": "nao-734092",
   "pages": [
    12
   ],
   "text": "三十五番左陵園一寒花衣雲菊涙敗墻露脱緑蕪風右水無瀬河つかへこし道はたえにきみなせ川汀の氷何むすふら翁三十六番同洞中嵐静松陰院山脚日長花底宮みなせ河むすはぬ袖のぬれそふはありて行物や泪なるらん右三十七番左昆明池杜若抽心連古岸鴛鴦舗翅睡春沙右音羽河氷ともきえて音羽の河なくはいかてか水のはるをきかまし三十八番左右○波浮西月堂秋鏡水浸南山倒暁花しりしらすすゝむ木陰は音羽河関のあなたも関のこなたも",
   "poems": [
    "35",
    "36",
    "37",
    "38"
   ]
  },
  {
   "id": "zoku-gunsho-wakan-meisho-shiikaawase-0013",
   "pid": "nao-734092",
   "pages": [
    13
   ],
   "text": "三十九番左商山暁鶏報月一原樹霜兎臥花百草壇右常磐山をしはかれ常磐の杜のゆくの山秋なれはとて時雨雷里四十番左漢皓出朝秋鬢老商山向路白雲残右みしか夜の明はなれ行常磐山か云春をはいつか詠めし四十一番左洞庭湖七聖軒遊秋楽静三江波路暮雲長右須磨浦もしほやく浦こそあらめたれすみてすまの上野も烟立らん四十二番左一阿郡中河岸松白巌桟霜肥湖橋黄右わかれちは昔をかけてもしほたれ余波とすれと残る月影",
   "poems": [
    "39",
    "40",
    "41",
    "42"
   ]
  },
  {
   "id": "zoku-gunsho-wakan-meisho-shiikaawase-0014",
   "pid": "nao-734092",
   "pages": [
    14
   ],
   "text": "四十三番左上陽宮闕右龍田山たつた山霞も八重のみなと河くれなゐくゝる船やいつらん四十四番左南東北龍報漏闌孤院夜鴬帰去故宮春右たつゝ山神もやすらん柳かけゆふかけてよる夏の河波四十五番左尋陽江商客夜船ゝ語咽陶公旧宅浪声閑ニ右蘆屋里春くれはわかすむかたの霞をもいそく芦屋のなたの汐やき四十六番四日湖心秋月西亭岸・上春花東郭山左、右あしの屋の磯山紅葉こかれてやけにも一葉の舟とみるらん",
   "poems": [
    "43",
    "44",
    "45",
    "46"
   ]
  },
  {
   "id": "zoku-gunsho-wakan-meisho-shiikaawase-0015",
   "pid": "nao-734092",
   "pages": [
    15
   ],
   "text": "四十七番左盧山松上風高琴榻地池心荷馥草堂庭右冨士山ふりつゝく雪のさかひのふしのねや月の都の外山なるらん四十八番左林花春日東西寺渓水秋寒十八亭右夕烟たかみかしこみふしのねにゆきはゝかりてあまる白雲四十九番左昊江漁歌度岸孤舟路鱸鱠交江落葉紅右伊勢海浜萩の外にそつゝく雪おれやいせおの海士のまかきなるらん五十番白浪遠清寒夜月残松不忌昔秋風左右〽いせの海のあまの原なるいさり火も同し光の星合のそら",
   "poems": [
    "47",
    "48",
    "49",
    "50"
   ]
  },
  {
   "id": "zoku-gunsho-wakan-meisho-shiikaawase-0016",
   "pid": "nao-734092",
   "pages": [
    16
   ],
   "text": "五十一番左蜀郡江心洗錦巴千里鶏巴千里雑唱送花蜀二郡右高砂しる人もあらはやみせん高砂の尾上の松のはるのあけほの五十二番左孤鶴斜飛山月境人龍高歩嶺雲途二右舟つなく室のとまりの月影にまた高砂の松の松の松の松の松の松の松の松の松の松の松の松の松の松の松の松の松の松の松の松の松の松の松の松の松の松の松の松の五十三番左萃陽洞仙院咄嵐花白雪洞亭礙日竹青羅右田籠浦白妙のなみにたちそふあま人は花をさへくむたこの浦風五十四番立著松旧跡誰人住秋月清光此処多右たこのうらに欠うち出てみ渡せはうへ嶋かけてきゆる白雲",
   "poems": [
    "51",
    "52",
    "53"
   ]
  },
  {
   "id": "zoku-gunsho-wakan-meisho-shiikaawase-0017",
   "pid": "nao-734092",
   "pages": [
    17
   ],
   "text": "五十五番左復道里桃嶋春風停盞臥松台夕日負琴昇右難波江あしそよくなには渡りの夕くれは心有けるあき風そふく五十六番左竹池掬水蛍清冷花住買家鶯饗応右あしはらのみつほの国にまよふ哉いつはなにはの道はひろきに五十七番左清陽村里夏闇槐樹暗田園両積竹竿肥一右若浦うかれ行わかのうら船人なみにうちにはいてゝつなくてもなし五十八番左一堤孤柳懸漁綱二代帝師出釣磯いかにせん人にこえにしたらちねの跡はつかしきわかの浦波右",
   "poems": [
    "54",
    "55",
    "56",
    "57"
   ]
  },
  {
   "id": "zoku-gunsho-wakan-meisho-shiikaawase-0018",
   "pid": "nao-734092",
   "pages": [
    18
   ],
   "text": "五十九番左香炉峯遺愛松梢舎月曙峰鐘峯鐘響満花来右伏見山すかはらや伏見の里のあれまへも月まつ人と人やみるらん六十番十六草堂泉咽山陰水仙路衣寒雲夕台右ふしみ山都の人はそれなからくるれはかへるはるのかりかね六十一番左彭沢二県苔荒雲己閉船松鶏報月西貽右猪名野白度のいな野の小篠いかならん同しはやまも秋のむらま六十二番立菊芳彭沢琴詩境柳老陶窓八十眉右右かへるさをいそくいなのゝ旅ころもきるはよふかきけくしきなりとも",
   "poems": [
    "58",
    "59",
    "60",
    "61"
   ]
  },
  {
   "id": "zoku-gunsho-wakan-meisho-shiikaawase-0019",
   "pid": "nao-734092",
   "pages": [
    19
   ],
   "text": "六十三番五巌陵瀬陵イ巌子清栖星照曜留春楼路月経過右明石浦初雁もさしてやきつる明石かた昔の船のあとを多つねて六十四番左林中花落刃台雪洲上嵐高七里波吾国の光や月日空にのみいつもあかしのやまとしま山右六十五番左香山池閣波廻煙竹暗渓楼松曙暁鐘残り右佐夜中山あつまちの山のあなたの雲井とりみえつる月のさよの中山六十六番立春花古院一時雪秋雨香山六月灘ニ旅にしていも恋まつもあかしとてなになか〳〵のさよの中山右",
   "poems": [
    "62",
    "63",
    "64",
    "65"
   ]
  },
  {
   "id": "zoku-gunsho-wakan-meisho-shiikaawase-0020",
   "pid": "nao-734092",
   "pages": [
    20
   ],
   "text": "六十七番左胡塞一胡雁一噺来暁月漢臣百戦は秋城ハ一本右鳴海浦浦かけてなみは鳴海の海のりてひかりみちたる月の入しほ六十八番十五辺楡梢白霜歌路塞草へ寒雪顕行ニうらかけて波はなるみの海のかて光みちたる月の入しほ右六十九番左驪山墻竹瓦松皆白雪朱楼紫殿只青苔右天香具山雲の入あまのかく山ほの〳〵と明行空はみなさてなり七十番立泉呑百石飛空落若為万人遂不来もの思ふ心のおよふ方はなしくものはたてか天のかく山右",
   "poems": [
    "66",
    "67",
    "68",
    "69"
   ]
  },
  {
   "id": "zoku-gunsho-wakan-meisho-shiikaawase-0021",
   "pid": "nao-734092",
   "pages": [
    21
   ],
   "text": "一四七",
   "poems": []
  }
 ],
 "poems": [
  {
   "seq": "1",
   "text": "住吉のいかきのうちに燈す火やまとへる哥の闇路なるらん",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "一",
   "side": "右",
   "dai": "住吉浦"
  },
  {
   "seq": "2",
   "text": "すみの元に神のかたひくつなしあらは汐世のに船をして出とも",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "二",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "3",
   "text": "かすか山心のたねをまき置し野辺とやみえん花のこと草",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "三",
   "side": "右",
   "dai": "春日山"
  },
  {
   "seq": "4",
   "text": "なくそちに身は行かゝる春日山祈りし岑に月はくもるな",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "四",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "5",
   "text": "みしまえに芦かりすつる里人のかへさは松の音そすくなき",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "五",
   "side": "右",
   "dai": "三島江"
  },
  {
   "seq": "6",
   "text": "人なみにしつみ果たるみしまえの入江のみくりさけむせふらん",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "六",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "7",
   "text": "かつらきやおくの岩やの荒ましに心すめとや月はすむらん",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "七",
   "side": "右",
   "dai": "葛木山"
  },
  {
   "seq": "8",
   "text": "かつらきや嵐をゝへる山伏の苔のそてにも花そかゝれる",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "八",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "9",
   "text": "吾宿やよはすみかたき初瀬山かすむ河瀬山かすむ河瀬に月そ残れる",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "九",
   "side": "右",
   "dai": "泊瀬山"
  },
  {
   "seq": "10",
   "text": "あま小船初瀬の山に雁鳴て夕日さしこす峯の桟",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "十",
   "side": "",
   "dai": ""
  },
  {
   "seq": "11",
   "text": "むさし野はあすもいかなる露ならん同しころもの秋の花深",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "十一",
   "side": "右",
   "dai": "武蔵野"
  },
  {
   "seq": "12",
   "text": "落つもる露のきえすはむさし野の草葉の下や海となりまし",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "十二",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "13",
   "text": "あふきをもあ気てたとへよ松浦姫ひれふる袖の月にかせとか",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "十三",
   "side": "右",
   "dai": "松浦山"
  },
  {
   "seq": "14",
   "text": "瓜木たく烟そ降たふ松浦山もろこしへや冬こもるらん",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "十四",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "15",
   "text": "み宝山よゝの鏡や五月雨の雲のこなたの月をみすらん",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "十五",
   "side": "右",
   "dai": "御室山"
  },
  {
   "seq": "16",
   "text": "みむろ山したはふ葛の玉かつらかけてや雪のふるの神杉",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "十六",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "17",
   "text": "よし野山これもや花の数ならんみかきの原の秋の白きく",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "十七",
   "side": "右",
   "dai": "吉野"
  },
  {
   "seq": "18",
   "text": "さて咲春にならひのよし野山月にかくるな岑の白雲",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "十八",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "19",
   "text": "老ぬとて哀かくへき人そなき波にぬれたる宇治の橋姫",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "十九",
   "side": "右",
   "dai": "宇治川"
  },
  {
   "seq": "20",
   "text": "ふけぬるかうちの河瀬をさす棹のうゝかすさひそ月に残れる",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "二十",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "21",
   "text": "つく〳〵といつもなけきの同しえになをやしのたの杜のうくひす",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "二十一",
   "side": "右",
   "dai": "信太社"
  },
  {
   "seq": "22",
   "text": "ちえことのしつくは雪のたるひにてしのたのもりはみかさなくとも",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "二十二",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "23",
   "text": "きよみかたかすめる関のむかひより又煙たつふしの大嶋",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "二十三",
   "side": "右",
   "dai": "清見関"
  },
  {
   "seq": "24",
   "text": "関の戸は入海かけて清みかたかたかたかへこそはみめ秋の月",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "二十四",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "25",
   "text": "大井川かみはあかしの山さくらちれは入江の松のしらゆき",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "二十五",
   "side": "右",
   "dai": "大井川"
  },
  {
   "seq": "26",
   "text": "大井川はちあるみよの筏士は今やよもなの嶋つたふらん",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "二十六",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "27",
   "text": "ほとゝきすいこまの山は夏なからなに秋しのゝ里なれぬらん",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "二十七",
   "side": "右",
   "dai": "伊駒山"
  },
  {
   "seq": "28",
   "text": "あはれとはみつゝそこゆるいこま山花のあたりにのこる月影",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "二十八",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "29",
   "text": "五月雨に里にもみつの河近みほすりこもや庭の浮草",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "二十九",
   "side": "右",
   "dai": "美豆御牧"
  },
  {
   "seq": "30",
   "text": "里しるき民の煙をのこしつゝ水上はるゝみつの河きり",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "三十",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "31",
   "text": "きよたきや氷はてたる河風に猶石はしる雪のしら波",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "三十一",
   "side": "右",
   "dai": "清瀧河"
  },
  {
   "seq": "32",
   "text": "山もとの清滝川のそは伝ひ紅葉になりぬ桴をす郭",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "三十二",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "33",
   "text": "たかまとの山したあらしさゆる夜の野かみの薄露置ぬへし",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "三十三",
   "side": "右",
   "dai": "高円山"
  },
  {
   "seq": "34",
   "text": "雪もまた名におふみやと古郷の籬はけさやたまとの月",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "三十四",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "35",
   "text": "つかへこし道はたえにきみなせ川汀の氷何むすふら翁",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "三十五",
   "side": "右",
   "dai": "水無瀬河"
  },
  {
   "seq": "36",
   "text": "みなせ河むすはぬ袖のぬれそふはありて行物や泪なるらん",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "三十六",
   "side": "",
   "dai": ""
  },
  {
   "seq": "37",
   "text": "氷ともきえて音羽の河なくはいかてか水のはるをきかまし",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "三十七",
   "side": "右",
   "dai": "音羽河"
  },
  {
   "seq": "38",
   "text": "しりしらすすゝむ木陰は音羽河関のあなたも関のこなたも",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "三十八",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "39",
   "text": "をしはかれ常磐の杜のゆくの山秋なれはとて時雨雷里",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "三十九",
   "side": "右",
   "dai": "常磐山"
  },
  {
   "seq": "40",
   "text": "みしか夜の明はなれ行常磐山か云春をはいつか詠めし",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "四十",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "41",
   "text": "もしほやく浦こそあらめたれすみてすまの上野も烟立らん",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "四十一",
   "side": "右",
   "dai": "須磨浦"
  },
  {
   "seq": "42",
   "text": "わかれちは昔をかけてもしほたれ余波とすれと残る月影",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "四十二",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "43",
   "text": "たつた山霞も八重のみなと河くれなゐくゝる船やいつらん",
   "kana": "",
   "speaker": "",
   "page": 14,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "四十三",
   "side": "右",
   "dai": "龍田山"
  },
  {
   "seq": "44",
   "text": "たつゝ山神もやすらん柳かけゆふかけてよる夏の河波",
   "kana": "",
   "speaker": "",
   "page": 14,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "四十四",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "45",
   "text": "春くれはわかすむかたの霞をもいそく芦屋のなたの汐やき",
   "kana": "",
   "speaker": "",
   "page": 14,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "四十五",
   "side": "右",
   "dai": "蘆屋里"
  },
  {
   "seq": "46",
   "text": "あしの屋の磯山紅葉こかれてやけにも一葉の舟とみるらん",
   "kana": "",
   "speaker": "",
   "page": 14,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "四十六",
   "side": "右",
   "dai": "、"
  },
  {
   "seq": "47",
   "text": "ふりつゝく雪のさかひのふしのねや月の都の外山なるらん",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "四十七",
   "side": "右",
   "dai": "冨士山"
  },
  {
   "seq": "48",
   "text": "夕烟たかみかしこみふしのねにゆきはゝかりてあまる白雲",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "四十八",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "49",
   "text": "浜萩の外にそつゝく雪おれやいせおの海士のまかきなるらん",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "四十九",
   "side": "右",
   "dai": "伊勢海"
  },
  {
   "seq": "50",
   "text": "〽いせの海のあまの原なるいさり火も同し光の星合のそら",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "五十",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "51",
   "text": "しる人もあらはやみせん高砂の尾上の松のはるのあけほの",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "五十一",
   "side": "右",
   "dai": "高砂"
  },
  {
   "seq": "52",
   "text": "白妙のなみにたちそふあま人は花をさへくむたこの浦風",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "五十三",
   "side": "右",
   "dai": "田籠浦"
  },
  {
   "seq": "53",
   "text": "たこのうらに欠うち出てみ渡せはうへ嶋かけてきゆる白雲",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "五十四",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "54",
   "text": "あしそよくなには渡りの夕くれは心有けるあき風そふく",
   "kana": "",
   "speaker": "",
   "page": 17,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "五十五",
   "side": "右",
   "dai": "難波江"
  },
  {
   "seq": "55",
   "text": "あしはらのみつほの国にまよふ哉いつはなにはの道はひろきに",
   "kana": "",
   "speaker": "",
   "page": 17,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "五十六",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "56",
   "text": "うかれ行わかのうら船人なみにうちにはいてゝつなくてもなし",
   "kana": "",
   "speaker": "",
   "page": 17,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "五十七",
   "side": "右",
   "dai": "若浦"
  },
  {
   "seq": "57",
   "text": "いかにせん人にこえにしたらちねの跡はつかしきわかの浦波",
   "kana": "",
   "speaker": "",
   "page": 17,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "五十八",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "58",
   "text": "すかはらや伏見の里のあれまへも月まつ人と人やみるらん",
   "kana": "",
   "speaker": "",
   "page": 18,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "五十九",
   "side": "右",
   "dai": "伏見山"
  },
  {
   "seq": "59",
   "text": "ふしみ山都の人はそれなからくるれはかへるはるのかりかね",
   "kana": "",
   "speaker": "",
   "page": 18,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "六十",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "60",
   "text": "白度のいな野の小篠いかならん同しはやまも秋のむらま",
   "kana": "",
   "speaker": "",
   "page": 18,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "六十一",
   "side": "右",
   "dai": "猪名野"
  },
  {
   "seq": "61",
   "text": "かへるさをいそくいなのゝ旅ころもきるはよふかきけくしきなりとも",
   "kana": "",
   "speaker": "",
   "page": 18,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "六十二",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "62",
   "text": "初雁もさしてやきつる明石かた昔の船のあとを多つねて",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "六十三",
   "side": "右",
   "dai": "明石浦"
  },
  {
   "seq": "63",
   "text": "吾国の光や月日空にのみいつもあかしのやまとしま山",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "六十四",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "64",
   "text": "あつまちの山のあなたの雲井とりみえつる月のさよの中山",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "六十五",
   "side": "右",
   "dai": "佐夜中山"
  },
  {
   "seq": "65",
   "text": "旅にしていも恋まつもあかしとてなになか〳〵のさよの中山",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "六十六",
   "side": "",
   "dai": ""
  },
  {
   "seq": "66",
   "text": "浦かけてなみは鳴海の海のりてひかりみちたる月の入しほ",
   "kana": "",
   "speaker": "",
   "page": 20,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "六十七",
   "side": "右",
   "dai": "鳴海浦"
  },
  {
   "seq": "67",
   "text": "うらかけて波はなるみの海のかて光みちたる月の入しほ",
   "kana": "",
   "speaker": "",
   "page": 20,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "六十八",
   "side": "",
   "dai": ""
  },
  {
   "seq": "68",
   "text": "雲の入あまのかく山ほの〳〵と明行空はみなさてなり",
   "kana": "",
   "speaker": "",
   "page": 20,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "六十九",
   "side": "右",
   "dai": "天香具山"
  },
  {
   "seq": "69",
   "text": "もの思ふ心のおよふ方はなしくものはたてか天のかく山",
   "kana": "",
   "speaker": "",
   "page": 20,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "七十",
   "side": "",
   "dai": ""
  }
 ],
