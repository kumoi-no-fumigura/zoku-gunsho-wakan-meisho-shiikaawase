 "poems": [
  {
   "seq": "1",
   "text": "住吉のいかきのうちに燒火やまよへる哥の闇路なるらん",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "一",
   "side": "右",
   "dai": "住吉浦"
  },
  {
   "seq": "2",
   "text": "すみのえに神のこゝろひくつなしあらは汐せの小船をしてさき",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "二",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "3",
   "text": "かすか山心のたねをまき置し野辺とやみえん花のこと草",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "三",
   "side": "右",
   "dai": "春日山"
  },
  {
   "seq": "4",
   "text": "なくそちに身は行かゝる春日山祈りし岑に月はくもるな",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "四",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "5",
   "text": "みしまえに芦かりすつる里人のかへさは松の音そすくなき",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "五",
   "side": "右",
   "dai": "三島江"
  },
  {
   "seq": "6",
   "text": "人なみにしつみ果たるみしまえの入江のみくりさけむせふらん",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "六",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "7",
   "text": "かつらきやおくの岩やの荒ましに心すめとや月はすむらん",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "七",
   "side": "右",
   "dai": "葛木山"
  },
  {
   "seq": "8",
   "text": "かつらきや嵐をおへる山伏の苔のそてにも花そかゝれる",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "八",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "9",
   "text": "吾宿やよはすみかたき初瀬山かすむ河瀬に月そ残れる",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "九",
   "side": "右",
   "dai": "泊瀬山"
  },
  {
   "seq": "10",
   "text": "あま小舩初瀬の山に雁鳴て夕日さしこす峯の棧",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "十",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "11",
   "text": "むさし野はあすもいかなる露ならん同しころもの秋の花染",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "十一",
   "side": "右",
   "dai": "武藏野"
  },
  {
   "seq": "12",
   "text": "落つもる露のきえすはむさし野の草葉の下や海となりまし",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "十二",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "13",
   "text": "あふきをもあ氣てたとへよ松浦姫ひれふる袖の月にかせとか",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "十三",
   "side": "右",
   "dai": "松浦山"
  },
  {
   "seq": "14",
   "text": "瓜木たく烟そたゝよふ松浦山もろこしへや冬こもるらん",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "十四",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "15",
   "text": "み室山よゝの鏡や五月雨の雲のこなたの月をみすらん",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "十五",
   "side": "右",
   "dai": "御室山"
  },
  {
   "seq": "16",
   "text": "みむろ山したはふ葛の玉かつらかけてや雪のふるの神杉",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "十六",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "17",
   "text": "よし野山これもや花の数ならんみかきの原の秋の白きく",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "十七",
   "side": "右",
   "dai": "吉野"
  },
  {
   "seq": "18",
   "text": "さて咲春にならひのよし野山月にかくるな岑の白雲",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "十八",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "19",
   "text": "老ぬとて哀かくへき人そなき波にぬれたる宇治の橋姫",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "十九",
   "side": "右",
   "dai": "宇治川"
  },
  {
   "seq": "20",
   "text": "ふけぬるかうちの河瀬をさす棹のうたのすさひそ月に残れる",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "二十",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "21",
   "text": "つく〳〵といつもなけきの同しえになをやしのたの杜のうくひす",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "二十一",
   "side": "右",
   "dai": "信太杜"
  },
  {
   "seq": "22",
   "text": "ちえことのしつくは雪のたるひにてしのたのもりはみかさなくとも",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "二十二",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "23",
   "text": "きよみかたかすめる関のむかひより又煙たつふしの大嶋",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "二十三",
   "side": "右",
   "dai": "清見関"
  },
  {
   "seq": "24",
   "text": "関の戸は入海かけて清見かたかくこそはさゝめ秋の夜の月",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "二十四",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "25",
   "text": "大井川かみはあらしの山さくらちれは入江の松のしらゆき",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "二十五",
   "side": "右",
   "dai": "大井川"
  },
  {
   "seq": "26",
   "text": "大井川ちあるみよの筏士は今やよまなの路つたふらん",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "二十六",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "27",
   "text": "ほとゝきすいこまの山は夏なからなに妹しのゝ里なれぬらん",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "二十七",
   "side": "右",
   "dai": "伊駒山"
  },
  {
   "seq": "28",
   "text": "あはれとはみつゝそこゆるいこま山花のあたりにのこる月影",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "二十八",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "29",
   "text": "五月雨に里にもみつの河近みほすりこもや庭の浮草",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "二十九",
   "side": "右",
   "dai": "美豆御牧"
  },
  {
   "seq": "30",
   "text": "里しるき民の煙をのこしつゝ水上はるゝみつの河きり",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "三十",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "31",
   "text": "きよたきや氷はてたる河風に猶石はしる雪のしら波",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "三十一",
   "side": "右",
   "dai": "清瀧河"
  },
  {
   "seq": "32",
   "text": "山もとの清瀧川のそは傳ひ紅葉になりぬ桴のさほ",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "三十二",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "33",
   "text": "たかまとの山したあらしさゆる夜の野かみの薄露置ぬへし",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "三十三",
   "side": "右",
   "dai": "高圓山"
  },
  {
   "seq": "34",
   "text": "雪もまた名におふみやと古郷の籬はけさやたかまとの月",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "三十四",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "35",
   "text": "つかへこし道はたえにきみなせ川汀の氷何むすふらむ",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "三十五",
   "side": "右",
   "dai": "水無瀬河"
  },
  {
   "seq": "36",
   "text": "みなせ河むすはぬ袖のぬれそふはありて行物や泪なるらん",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "三十六",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "37",
   "text": "氷ともきえて音羽の河なくはいかてか水のこゑをきかまし",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "三十七",
   "side": "右",
   "dai": "音羽河"
  },
  {
   "seq": "38",
   "text": "しりしらすすゝむ木陰は音羽河関のあなたも関のこなたも",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "三十八",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "39",
   "text": "をしはかれ常磐の杜のおくの山秋なれはとて時雨る里",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "三十九",
   "side": "右",
   "dai": "常磐山"
  },
  {
   "seq": "40",
   "text": "みしか夜の明はなれ行常磐山かゝる春をはいつか詠めし",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "四十",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "41",
   "text": "もしほやく浦こそあらめたれすみてすまの上野も烟立らん",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "四十一",
   "side": "右",
   "dai": "須磨浦"
  },
  {
   "seq": "42",
   "text": "わかれちは昔をかけてもしほたれ余波とすれと残る月影",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "四十二",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "43",
   "text": "たつた山霞も八重のみなと河くれなゐくゝる舩やいつらん",
   "kana": "",
   "speaker": "",
   "page": 14,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "四十三",
   "side": "右",
   "dai": "龍田山"
  },
  {
   "seq": "44",
   "text": "たつた山神もやすらん柳かけゆふかけてよる夏の河波",
   "kana": "",
   "speaker": "",
   "page": 14,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "四十四",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "45",
   "text": "春くれはわかすむかたの霞をもいそく芦屋のなたの汐やき",
   "kana": "",
   "speaker": "",
   "page": 14,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "四十五",
   "side": "右",
   "dai": "蘆屋里"
  },
  {
   "seq": "46",
   "text": "あしの屋の磯山紅葉こかれてやけにも一葉の舟とみるらん",
   "kana": "",
   "speaker": "",
   "page": 14,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "四十六",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "47",
   "text": "ふりつゝく雪のさかひのふしのねや月の都の外山なるらん",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "四十七",
   "side": "右",
   "dai": "冨士山"
  },
  {
   "seq": "48",
   "text": "夕烟たかみかしこみふしのねにゆきはゝかりてあまる白雲",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "四十八",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "49",
   "text": "濱荻の外にそつゝく雪おれやいせおの海士のまかきなるらん",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "四十九",
   "side": "右",
   "dai": "伊勢海"
  },
  {
   "seq": "50",
   "text": "いせの海のあまの原なるいさり火も同し光の星合のそら",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "五十",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "51",
   "text": "しる人もあらはやみせん高砂の尾上の松のはるのあけほの",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "五十一",
   "side": "右",
   "dai": "高砂"
  },
  {
   "seq": "52",
   "text": "舟つなく室のとまりの月影にまた高砂の松の秋風",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "五十二",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "53",
   "text": "白妙のなみにたちそふあま人は花をさへくむたこの浦風",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "五十三",
   "side": "右",
   "dai": "田籠浦"
  },
  {
   "seq": "54",
   "text": "たこのうらにうち出てみ渡せはうへ嶋かけてきゆる白雲",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "五十四",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "55",
   "text": "あしそよくなには渡りの夕くれは心有けるあき風そふく",
   "kana": "",
   "speaker": "",
   "page": 17,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "五十五",
   "side": "右",
   "dai": "難波江"
  },
  {
   "seq": "56",
   "text": "あしはらのみつほの國にまよふ哉いつはなにはの道はひろきに",
   "kana": "",
   "speaker": "",
   "page": 17,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "五十六",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "57",
   "text": "うかれ行わかのうら船人なみにうちにはいてゝつなくてもなし",
   "kana": "",
   "speaker": "",
   "page": 17,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "五十七",
   "side": "右",
   "dai": "若浦"
  },
  {
   "seq": "58",
   "text": "いかにせん人にこえにしたらちねの跡はつかしきわかの浦波",
   "kana": "",
   "speaker": "",
   "page": 17,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "五十八",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "59",
   "text": "すかはらや伏見の里のあれまくも月まつ人と人やみるらん",
   "kana": "",
   "speaker": "",
   "page": 18,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "五十九",
   "side": "右",
   "dai": "伏見山"
  },
  {
   "seq": "60",
   "text": "ふしみ山都の人はそれなからくるれはかへるはるのかりかね",
   "kana": "",
   "speaker": "",
   "page": 18,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "六十",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "61",
   "text": "白露のいな野の小篠いかならん同しはやまも秋のむら雨",
   "kana": "",
   "speaker": "",
   "page": 18,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "六十一",
   "side": "右",
   "dai": "猪名野"
  },
  {
   "seq": "62",
   "text": "かへるさをいそくいなのゝ旅ころもきるはよふかきけしきなりとも",
   "kana": "",
   "speaker": "",
   "page": 18,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "六十二",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "63",
   "text": "初雁もさしてやきつる明石かた昔の秋のあとをたつねて",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "六十三",
   "side": "右",
   "dai": "明石浦"
  },
  {
   "seq": "64",
   "text": "吾國の光や月日空にのみいつもあかしのやまとしま山",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "六十四",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "65",
   "text": "あつまちの山のあなたの雲井よりみえつる月のさよの中山",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "六十五",
   "side": "右",
   "dai": "佐夜中山"
  },
  {
   "seq": "66",
   "text": "旅にしていも恋まつもあかしとてなになか〳〵のさよの中山",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "六十六",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "67",
   "text": "浦かけてなみは鳴海の海のりてひかりみちたる月の入しほ",
   "kana": "",
   "speaker": "",
   "page": 20,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "六十七",
   "side": "右",
   "dai": "鳴海浦"
  },
  {
   "seq": "68",
   "text": "うらかけて波はなるみの海のかて光みちたる月の入しほ",
   "kana": "",
   "speaker": "",
   "page": 20,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "六十八",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "69",
   "text": "雲の入あまのかく山ほの〳〵と明行空はみなさてなり",
   "kana": "",
   "speaker": "",
   "page": 20,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "六十九",
   "side": "右",
   "dai": "天香具山"
  },
  {
   "seq": "70",
   "text": "もの思ふ心のおよふ方はなしくものはたてか天のかく山",
   "kana": "",
   "speaker": "",
   "page": 20,
   "pid": "nao-734092",
   "form": "短歌",
   "genre": "",
   "ban": "七十",
   "side": "右",
   "dai": ""
  }
 ],
